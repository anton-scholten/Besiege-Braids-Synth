<Block>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Synth Block</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>synth block</Keyword>
		<Keyword>braids</Keyword>
		<Keyword>oscillator</Keyword>
		<Keyword>macro oscillator</Keyword>
		<Keyword>sound</Keyword>
		<Keyword>music</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<BraidsSynth modid="89025196-4dcd-4213-b839-2f95cd35a942" />
	</Modules>

	<!-- The Special Effects text block's cage, with its lettering stripped out so
	     that what stands inside it is the note NoteMesh builds. Modelled around the
	     origin over a span of two, hence the half scale and the lift onto the base
	     point. -->
	<Mesh name="SynthBlock_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="SynthBlock_texture" />

	<!-- How the block is posed for its toolbar thumbnail. Icon Scale is measured
	     against the *raw* model, not against the Mesh scale above: the game's own
	     blocks are modelled at a hundred times size and carry Mesh 0.01 with
	     Icon 0.008, which would vanish if the two multiplied. This cage spans two
	     units where the old mesh spanned nine tenths, so the scale it used to have
	     drew the block more than twice too large. These are the text block's own
	     numbers, for what is now the text block's own mesh. -->
	<Icon>
		<Position x="0.0" y="0.0" z="-1.0" />
		<Rotation x="-20.0" y="45.0" z="0.0" />
		<Scale x="0.25" y="0.25" z="0.25" />
	</Icon>

	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
			<Position x="0" y="0" z="0.3" />
			<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<!-- Without a collider the block has nothing to be hit by a cannonball, and
	     nothing for the cursor to find once it is on the machine. -->
	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<!-- The face the block is placed on. Without a BasePoint the block cannot be
	     attached to a machine at all, which is what "no block appears" looks
	     like from the toolbar. -->
	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" />
	</BasePoint>

	<!-- The five free faces of the cube, so blocks can be stacked onto it. -->
	<AddingPoints>
		<AddingPoint> <!-- top -->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- back -->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- front -->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- left -->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- right -->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
	</AddingPoints>
</Block>
