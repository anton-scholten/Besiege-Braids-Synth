<Block>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Synth Block</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>synth block</Keyword>
		<Keyword>braids</Keyword>
		<Keyword>oscillator</Keyword>
		<Keyword>macro oscillator</Keyword>
		<Keyword>sound</Keyword>
		<Keyword>music</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<BraidsSynth modid="89025196-4dcd-4213-b839-2f95cd35a942" />
	</Modules>

	<!-- A pair of beamed semiquavers, generated by tools/make-block-mesh.py.
	     Modelled around the origin over a span of about two, hence the half scale
	     and the lift onto the base point. -->
	<Mesh name="SynthBlock_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="SynthBlock_texture" />

	<!-- How the block is posed for its toolbar tile: the note's face, from above,
	     turned right into the light. The rotation is Orchestra's, which its piano
	     and guitar use to point a front at the viewer, and the note's readable face
	     is this block's front in the same way.

	     Icon Scale is measured against the *raw* model, not against the Mesh scale
	     above: the game's own blocks are modelled at a hundred times size and carry
	     Mesh 0.01 with Icon 0.008, which would vanish if the two multiplied. The
	     note spans 1.8 where Orchestra's piano spans 1.6, so 0.40 here draws it at
	     about the size 0.45 draws the piano. -->
	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" />
		<Rotation x="-65.0" y="210.0" z="115.0" />
		<Scale x="0.40" y="0.40" z="0.40" />
	</Icon>

	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
			<Position x="0" y="0" z="0.3" />
			<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<!-- Without a collider the block has nothing to be hit by a cannonball, and
	     nothing for the cursor to find once it is on the machine. -->
	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<!-- The face the block is placed on. Without a BasePoint the block cannot be
	     attached to a machine at all, which is what "no block appears" looks
	     like from the toolbar. -->
	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" />
	</BasePoint>

	<!-- The five free faces of the cube, so blocks can be stacked onto it. -->
	<AddingPoints>
		<AddingPoint> <!-- top -->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- back -->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- front -->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- left -->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
		<AddingPoint> <!-- right -->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0" />
		</AddingPoint>
	</AddingPoints>
</Block>
